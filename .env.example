# ============================================================
# CAE AI Platform
# 默认：完全离线，本地 LLM + 本地 Embedding + Dense Retrieval
# 项目会自动读取根目录 .env
# ============================================================

# ---------- Local LLM ----------
CAE_LLM_PROVIDER=local
CAE_LLM_MODEL_PATH=./artifacts/models/llm/Qwen3-8B
CAE_LLM_DEVICE=auto
CAE_LLM_DEVICE_MAP=
CAE_LLM_DTYPE=auto
CAE_LLM_MAX_TOKENS=1024
CAE_LLM_MAX_INPUT_TOKENS=0
CAE_LLM_TEMPERATURE=0.2
CAE_LLM_TOP_P=0.9
CAE_LLM_ENABLE_THINKING=false
CAE_LLM_TRUST_REMOTE_CODE=false

# 切换 API 时改为 api，并填写以下三项
# CAE_LLM_PROVIDER=api
CAE_LLM_BASE_URL=http://127.0.0.1:8000/v1
CAE_LLM_API_KEY=
CAE_LLM_MODEL=

# ---------- Local Embedding ----------
CAE_EMBED_PROVIDER=local
CAE_EMBED_MODEL_PATH=./artifacts/models/embedding/bge-m3
CAE_EMBED_DEVICE=auto
CAE_EMBED_BATCH=32
CAE_EMBED_MAX_LENGTH=1024
CAE_EMBED_NORMALIZE=true
CAE_EMBED_CACHE_ENABLED=true
CAE_EMBED_TRUST_REMOTE_CODE=false

# 切换 API 时改为 api
# CAE_EMBED_PROVIDER=api
CAE_EMBED_BASE_URL=http://127.0.0.1:8001/v1
CAE_EMBED_API_KEY=
CAE_EMBED_MODEL=

# ---------- Ingest / chunk ----------
CAE_CHUNK_SIZE=900
CAE_CHUNK_OVERLAP=120
CAE_INGEST_BATCH_SIZE=64
CAE_INGEST_SKIP_UNCHANGED=true

# ---------- Retrieval ----------
# dense：默认，速度快；hybrid：dense + BM25 + RRF，通常召回更稳
CAE_RETRIEVAL_MODE=dense
CAE_TOP_K=6
CAE_CANDIDATE_K=20
CAE_SIM_THRESHOLD=0.25
CAE_RRF_K=60
CAE_HYBRID_DENSE_WEIGHT=0.65
CAE_HYBRID_LEXICAL_WEIGHT=0.35

# ---------- Optional reranker ----------
CAE_RERANK_ENABLED=false
CAE_RERANK_MODEL_PATH=./artifacts/models/reranker/bge-reranker-v2-m3
CAE_RERANK_DEVICE=auto
CAE_RERANK_BATCH=8
CAE_RERANK_MAX_LENGTH=512

# ---------- Storage ----------
CAE_COLLECTION_NAME=cae_docs
# CAE_DATA_DIR=/absolute/path/to/documents
# CAE_STORAGE_DIR=/absolute/path/to/storage
# CAE_CACHE_DIR=/absolute/path/to/cache
